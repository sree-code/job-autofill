{
  "name": "job-autofill",
  "version": "0.6.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "test": "node --test test/*.test.mjs",
    "mock": "node test/mock-claude.mjs",
    "telemetry": "node telemetry/server.mjs",
    "screenshots": "node build.mjs --fixtures && node scripts/screenshots.mjs",
    "guide": "node scripts/guide-pdf.mjs",
    "telemetry:vercel": "node scripts/build-telemetry-vercel.mjs",
    "package": "node build.mjs && node scripts/package-store.mjs",
    "store:screenshots": "node build.mjs --fixtures && STORE=1 node scripts/screenshots.mjs",
    "test:e2e": "node build.mjs && node test/panel-e2e.mjs && node test/engine-extension-e2e.mjs",
    "engine": "node scripts/build-engine.mjs",
    "engine:test": "node scripts/build-engine.mjs --test"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.10.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@angular/common": "^17.3.12",
    "@angular/compiler": "^17.3.12",
    "@angular/core": "^17.3.12",
    "@angular/forms": "^17.3.12",
    "@angular/platform-browser": "^17.3.12",
    "angular": "^1.8.3",
    "esbuild": "^0.28.2",
    "puppeteer-core": "25.16.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "rxjs": "^7.8.1",
    "vue": "^3.4.38",
    "zone.js": "^0.14.10"
  }
}
