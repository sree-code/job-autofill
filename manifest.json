{
  "manifest_version": 3,
  "name": "Job Autofill (local)",
  "version": "0.1.0",
  "description": "Autofill job application forms from a profile stored only on your machine.",
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": ["https://*/*", "http://*/*"],
  "background": { "service_worker": "src/background.js" },
  "action": { "default_popup": "src/popup.html", "default_icon": { "128": "icons/icon128.png" } },
  "options_page": "src/options.html",
  "icons": { "128": "icons/icon128.png" },
  "content_scripts": [
    {
      "matches": ["https://*/*", "http://*/*", "file:///*"],
      "js": ["src/matcher.js", "src/filler.js", "src/adapters.js", "src/content.js"],
      "css": ["src/content.css"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "autofill": { "suggested_key": { "default": "Alt+Shift+F" }, "description": "Autofill this page" }
  }
}
